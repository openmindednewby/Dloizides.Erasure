<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <HouseArchitectureStyle>Clean</HouseArchitectureStyle>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>

    <Authors>DLoizides</Authors>
    <Company>OnlineMenu</Company>
    <PackageProjectUrl>https://github.com/openmindednewby/Dloizides.Erasure</PackageProjectUrl>
    <RepositoryUrl>https://github.com/openmindednewby/Dloizides.Erasure</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <PackageTags>gdpr;erasure;right-to-be-forgotten;retention;receipt;aspnetcore;saas</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Description>GDPR erasure participant contract: an idempotent, secret-protected POST endpoint that returns a per-dataset receipt (erased, anonymised, or retained with basis and end date) with a read-back count, plus a conformance helper each consuming service runs in its own tests.</Description>

    <Version>0.1.0</Version>
    <AssemblyVersion>0.1.0.0</AssemblyVersion>
    <FileVersion>0.1.0.0</FileVersion>

    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>

    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591;CS1573</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Dloizides.Analyzers" Version="0.10.1" PrivateAssets="all" />
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="10.0.401" PrivateAssets="All"/>
  </ItemGroup>

  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
  <PropertyGroup Label="RULES-ANALYZER-1 baselines">
    <RulesAnalyzerBaselineRoot>$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)', '.'))</RulesAnalyzerBaselineRoot>
    <DloizidesBaselinedRulesAsErrors>true</DloizidesBaselinedRulesAsErrors>
  </PropertyGroup>
  <ItemGroup Label="RULES-ANALYZER-1 baselines">
    <AdditionalFiles Include="$(RulesAnalyzerBaselineRoot)linq-syntax-baseline.txt" Condition="Exists('$(RulesAnalyzerBaselineRoot)linq-syntax-baseline.txt')" />
    <AdditionalFiles Include="$(RulesAnalyzerBaselineRoot)member-order-baseline.txt" Condition="Exists('$(RulesAnalyzerBaselineRoot)member-order-baseline.txt')" />
    <AdditionalFiles Include="$(RulesAnalyzerBaselineRoot)file-size-baseline.txt" Condition="Exists('$(RulesAnalyzerBaselineRoot)file-size-baseline.txt')" />
  </ItemGroup>
</Project>
